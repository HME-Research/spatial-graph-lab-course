{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "@core/*": ["./lab/core/*"],
      "@app/*": ["./lab/app/*"],
      "@student-api": ["./lab/student-api/index.ts"]
    }
  },
  "include": ["lab/core", "lab/app", "lab/student-api", "toolkits", "lab/docs/templates", "lab/docs/ai-kit/graph/examples", "lab/docs/ai-kit/design/examples", "vite.config.ts"]
}
